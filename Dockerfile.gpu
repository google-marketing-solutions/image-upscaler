# Production NVIDIA L4 GPU Container for ImageUpscaler
# Machine Spec: 1x NVIDIA L4 GPU (24 GB VRAM), 4-8 vCPU, 16-32 GiB RAM, gen2

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PORT=8080 \
    USE_MOCK_GCS=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libjpeg-turbo8 \
    libwebp7 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r appgroup \
    && useradd -r -g appgroup -d /app -s /sbin/nologin appuser

COPY requirements.txt .
RUN pip3 install --no-cache-dir \
    --require-hashes \
    --index-url https://pypi.org/simple \
    -r requirements.txt

COPY app/ ./app/

RUN mkdir -p /app/local_gcs_bucket /app/output \
    && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8080

ENTRYPOINT ["python3", "-m", "uvicorn", "app.main:app", \
            "--host", "0.0.0.0", "--port", "8080"]
