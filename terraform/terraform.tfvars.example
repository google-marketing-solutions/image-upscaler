project_id                = "your-gcp-project-id"
region                    = "asia-northeast1"
access_code               = "change-me-deployment-access-code"
firestore_database_id     = "gmc-upscaler-db"
# Leave empty to auto-create <project_id>-gmc-upscaler
public_gcs_bucket_name    = ""
auto_build_container      = true
enable_l4_gpu             = false
default_target_resolution = 500
default_engine_id         = "local-lanczos-canvas"
job_task_shards           = 10
